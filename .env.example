# Environment Configuration Example
# Copy this to .env and customize as needed

# Server Configuration
PORT=3000
NODE_ENV=development

# Graceful Shutdown Configuration
# Time to wait for active connections to complete before forcing shutdown (in milliseconds)
SHUTDOWN_TIMEOUT=30000

# API Authentication
# Required for direct API access (curl, Postman, external apps)
# Requests from the frontend are automatically allowed
API_KEY=your-secret-api-key-here

# OpenAI and Tavily API Keys (required for travel search)
# OPENAI_API_KEY=sk-your-openai-key
# TAVILY_API_KEY=tvly-your-tavily-key
