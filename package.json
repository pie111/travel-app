{
  "name": "car-app",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production bun run index.ts",
    "dev": "NODE_ENV=development bun --watch index.ts",
    "build": "bun build index.ts --target=bun --outdir=./dist",
    "build:client": "bun build client/src/main.tsx --outdir=client/dist --minify",
    "health": "curl -f http://localhost:${PORT:-3000}/health || exit 1",
    "ready": "curl -f http://localhost:${PORT:-3000}/ready || exit 1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.13",
    "@elysiajs/static": "^1.4.7",
    "@langchain/community": "^1.1.1",
    "@langchain/core": "^1.1.8",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/openai": "^1.2.0",
    "@langchain/tavily": "^1.2.0",
    "elysia": "^1.4.19",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}